# Secret values only. Copy to .env.secrets; the real file is ignored and must
# be supplied through an approved secret manager in production.
ONPREM_DLP_REDACTION_HASH_SALT=REPLACE_WITH_RANDOM_SECRET
ONPREM_DLP_MYSQL_PASSWORD=REPLACE_WITH_SECRET
# For BigQuery, prefer workload identity. If an on-prem credential file is
# unavoidable, mount it read-only and set this path in the secret environment.
GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/google/key.json
