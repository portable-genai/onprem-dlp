# Non-secret deployment settings. Copy to .env; the real file is ignored.
#
# Every variable below is read in THREE states. Leaving one out takes the documented
# default; setting one to an EMPTY value is a configuration error and refuses at startup,
# because "nobody configured this" and "an operator set it to nothing" must not mean the
# same thing for a gate that decides what leaves the estate.
ONPREM_DLP_PROFILE=local
ONPREM_DLP_CONFIG=/app/config/settings.yaml
ONPREM_DLP_AUDIT_RETENTION_DAYS=180
# REST surface. It authenticates nobody, so it binds loopback unless BOTH of the next two
# are set, and then only where a network control is the compensating boundary.
ONPREM_DLP_API_HOST=127.0.0.1
ONPREM_DLP_API_PORT=8484
# ONPREM_DLP_ALLOW_UNAUTHENTICATED_EXPOSURE=1
# Exact browser origins, comma separated. Never "*"; empty grants nothing.
# ONPREM_DLP_API_CORS_ORIGINS=https://ops.example
ONPREM_DLP_IMAGE_REPOSITORY=REPLACE_WITH_REGISTRY/onprem-dlp
ONPREM_DLP_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_TAG
ONPREM_DLP_K8S_NAMESPACE=onprem-dlp
ONPREM_DLP_BIGQUERY_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
ONPREM_DLP_BIGQUERY_DATASET=REPLACE_WITH_BIGQUERY_DATASET
ONPREM_DLP_MYSQL_DSN=mysql://REPLACE_WITH_USER@REPLACE_WITH_HOST/REPLACE_WITH_DATABASE
